# FFMPEG MCP Server - self-contained CI image (no external base registry required)
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY src/ ./src/
COPY tests/ci/test_unit_core.py ./tests/ci/

RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir -e .[dev]

CMD ["python3", "-m", "pytest", "tests/ci/test_unit_core.py", "-v"]

LABEL maintainer="ismailubts" \
      version="1.0.0-ci" \
      description="Pulse FFmpeg MCP - CI build"
